# Install as /etc/lzib-movements.env, owner root:lzib-movements, mode 0640.
SPECIAL_ARRIVALS_WEBHOOK_URL=
UNUSUAL_MOVEMENTS_WEBHOOK_URL=
AIRPORT_IATA=BTS
AIRPORT_ICAO=LZIB
AIRPORT_LATITUDE=48.170167
AIRPORT_LONGITUDE=17.212667
LOCAL_TIMEZONE=Europe/Bratislava
AIRPLANES_LIVE_SEARCH_RADIUS_NM=250
AIRPLANES_LIVE_POLL_INTERVAL_SECONDS=300
AIRPLANES_LIVE_DAILY_REQUEST_LIMIT=500
AIRPLANES_LIVE_REQUEST_RESERVE=40
UNUSUAL_MOVEMENT_RADIUS_KM=40
UNUSUAL_MOVEMENT_MAX_ALTITUDE_FT=8000
UNUSUAL_MOVEMENT_MIN_DESCENT_RATE_FPM=100
MAX_POSITION_AGE_SECONDS=120
ALERT_COOLDOWN_HOURS=12
RECENT_DEPARTURE_SUPPRESSION_MINUTES=30
ROUTE_DATA_MAX_AGE_DAYS=7
ROUTE_UPDATE_INTERVAL_HOURS=24
LOG_LEVEL=INFO
DRY_RUN=false
DATABASE_PATH=/var/lib/lzib-movements/lzib-movements.db
SPECIAL_REGISTRATIONS_PATH=/var/lib/lzib-movements/special_registrations.json
IGNORED_REGISTRATIONS_PATH=/var/lib/lzib-movements/ignored_registrations.json

