[Unit]
Description=Update LZIB Movements VRS route data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lzib-movements
Group=lzib-movements
WorkingDirectory=/opt/lzib-movements
EnvironmentFile=/etc/lzib-movements.env
ExecStart=/opt/lzib-movements/.venv/bin/python -m lzib_movements update-routes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lzib-movements
UMask=0027

